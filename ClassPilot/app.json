{
  "expo": {
    "name": "ClassPilot",
    "slug": "classpilot",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "classpilot",
    "plugins": [
      "expo-router",
      [
        "expo-local-authentication",
        { "faceIDPermission": "ClassPilot uses Face ID to protect your records." }
      ]
    ],
    "experiments": { "typedRoutes": true },
    "ios": { "supportsTablet": true },
    "android": { "edgeToEdgeEnabled": true },
    "web": { "bundler": "metro" },
    "owner": "punishertpks-team",
    "extra": {
      "eas": { "projectId": "d052233c-b68d-4eb4-bbfa-f1f635085f77" }
    }
  }
}
